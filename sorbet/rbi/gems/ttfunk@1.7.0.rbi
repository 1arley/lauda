module TTFunk::Table::Cmap::Format00
  # pkg:gem/ttfunk#lib/ttfunk/table/cmap/format00.rb:35
  def [](code); end

  # pkg:gem/ttfunk#lib/ttfunk/table/cmap/format00.rb:8
  def code_map; end

  # pkg:gem/ttfunk#lib/ttfunk/table/cmap/format00.rb:7
