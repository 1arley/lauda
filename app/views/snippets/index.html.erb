<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Snippets</h1>
    <p class="mt-1 text-sm text-gray-500">Trechos padronizados para laudos</p>
  </div>
  <div class="mt-4 sm:mt-0">
    <%= link_to new_snippet_path, class: "inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" do %>
      <svg class="-ml-0.5 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Novo Snippet
    <% end %>
  </div>
</div>

<% if @snippets.any? %>
  <div class="space-y-3">
    <% @snippets.each do |snippet| %>
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4">
        <div class="flex items-start justify-between">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="text-sm font-semibold text-gray-900"><%= snippet.title %></h3>
              <% if snippet.category.present? %>
                <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600"><%= snippet.category %></span>
              <% end %>
            </div>
            <p class="text-sm text-gray-500 line-clamp-2"><%= snippet.content %></p>
          </div>
          <div class="flex gap-2 ml-4 shrink-0">
            <%= link_to "Editar", edit_snippet_path(snippet), class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to "Excluir", snippet_path(snippet), data: { turbo_method: :delete, turbo_confirm: "Excluir snippet?" }, class: "text-sm text-red-600 hover:text-red-800" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "Nenhum snippet", message: "Crie trechos padronizados para usar nos laudos." %>
<% end %>
