<div class="max-w-2xl">
  <div class="mb-8">
    <%= link_to assessment_path(@assessment), class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Voltar para Avaliação
    <% end %>
    <div class="mt-2">
      <h1 class="text-2xl font-bold text-gray-900">Calcular Escores</h1>
      <p class="mt-1 text-sm text-gray-500"><%= @instrument_application.instrument_version.display_name %></p>
    </div>
  </div>

  <% if @instrument_application.answer_sets.any? %>
    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 mb-6">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Respostas registradas</h3>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 text-gray-500">Subteste</th>
            <th class="text-right py-2 text-gray-500">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @instrument_application.answer_sets.ordered.each do |as| %>
            <tr class="border-b border-gray-100">
              <td class="py-2 text-gray-900"><%= as.subtest_name %></td>
              <td class="py-2 text-right font-medium text-gray-900"><%= as.answers.values.sum %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= form_with url: compute_assessment_instrument_application_path(@assessment, @instrument_application), method: :post, class: "space-y-6" do |f| %>
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Tabela Normativa *</label>
        <%= f.collection_select :normative_table_id, @normative_tables, :id, :name, { prompt: "Selecione a tabela normativa" }, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        <p class="mt-2 text-xs text-gray-500">A versão da norma ficará registrada para rastreabilidade.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= f.submit "Calcular escores", class: "rounded-lg bg-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-500 cursor-pointer" %>
        <%= link_to "Cancelar", assessment_path(@assessment), class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-yellow-800">
      Nenhuma resposta registrada. Volte e preencha as respostas primeiro.
    </div>
  <% end %>
</div>
