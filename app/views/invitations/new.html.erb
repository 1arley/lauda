<div class="max-w-2xl">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Convidar para a clínica</h1>
    <p class="mt-1 text-sm text-gray-500">
      <%= current_user.tenant.name %> · a pessoa recebe um e-mail com o link para criar a senha dela.
    </p>
  </div>

  <%= form_with(model: @invitation, url: invitations_path, class: "space-y-6") do |f| %>
    <% if @invitation.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 border border-red-200">
        <ul class="mt-2 list-disc list-inside text-sm text-red-700">
          <% @invitation.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">E-mail *</label>
        <%= f.email_field :email, required: true, autofocus: true, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:border-blue-500" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Papel *</label>
        <%= f.select :role, Invitation::INVITABLE_ROLES.map { |role| [role.humanize, role] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:border-blue-500" %>
        <p class="mt-2 text-xs text-gray-500">Administrador da clínica, Profissional ou Revisor.</p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Enviar convite", class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Cancelar", root_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
    </div>
  <% end %>
</div>
