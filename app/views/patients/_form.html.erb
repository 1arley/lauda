<div class="max-w-2xl">
  <div class="mb-8">
    <%= link_to patients_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Voltar
    <% end %>
    <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= @patient.persisted? ? "Editar Paciente" : "Novo Paciente" %></h1>
  </div>

  <%= form_with(model: @patient, class: "space-y-6") do |f| %>
    <% if @patient.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 border border-red-200">
        <h3 class="text-sm font-medium text-red-800">Revise os campos abaixo:</h3>
        <ul class="mt-2 list-disc list-inside text-sm text-red-700">
          <% @patient.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 space-y-4">
      <div>
        <%= f.label :name, "Nome completo *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500", required: true %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :birth_date, "Data de nascimento", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :birth_date, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        </div>
        <div>
          <%= f.label :cpf, "CPF", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :cpf, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500", placeholder: "000.000.000-00" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :gender, "Gênero", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :gender, options_for_select(["", "Masculino", "Feminino", "Outro", "Não informado"], @patient.gender), {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        </div>
        <div>
          <%= f.label :phone, "Telefone", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :phone, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500", placeholder: "(00) 00000-0000" %>
        </div>
      </div>

      <div>
        <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :notes, "Observações", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :notes, rows: 3, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit @patient.persisted? ? "Salvar alterações" : "Cadastrar paciente", class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Cancelar", (@patient.persisted? ? patient_path(@patient) : patients_path), class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
    </div>
  <% end %>
</div>
