# pkg:gem/ttfunk#lib/ttfunk/table/os2.rb:259
TTFunk::Table::OS2::SPACE_GLYPH_MISSING_ERROR = T.let(T.unsafe(nil), String)

# pkg:gem/ttfunk#lib/ttfunk/table/os2.rb:81
