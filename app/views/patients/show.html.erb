<div class="mb-8">
  <%= link_to patients_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
    &larr; Voltar para Pacientes
  <% end %>
  <div class="mt-2 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @patient.name %></h1>
      <p class="mt-1 text-sm text-gray-500">
        <% if @patient.birth_date %>
          <%= @patient.age %> anos &middot; Nascimento: <%= @patient.birth_date.strftime("%d/%m/%Y") %>
        <% end %>
        <% if @patient.cpf.present? %>
          &middot; CPF: <%= @patient.cpf.gsub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4') %>
        <% end %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to edit_patient_path(@patient), class: "rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50" do %>
        Editar
      <% end %>
      <%= link_to new_assessment_path(patient_id: @patient.id), class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" do %>
        Nova Avaliação
      <% end %>
    </div>
  </div>
</div>

<% if @patient.email.present? || @patient.phone.present? || @patient.notes.present? %>
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 mb-6 p-4">
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <% if @patient.email.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">E-mail</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @patient.email %></dd>
        </div>
      <% end %>
      <% if @patient.phone.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Telefone</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @patient.phone %></dd>
        </div>
      <% end %>
      <% if @patient.gender.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase">Gênero</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @patient.gender %></dd>
        </div>
      <% end %>
    </dl>
    <% if @patient.notes.present? %>
      <div class="mt-4 pt-4 border-t border-gray-200">
        <dt class="text-xs font-medium text-gray-500 uppercase">Observações</dt>
        <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @patient.notes %></dd>
      </div>
    <% end %>
  </div>
<% end %>

<div class="bg-white shadow-sm rounded-lg border border-gray-200">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <h2 class="text-lg font-medium text-gray-900">Avaliações</h2>
  </div>
  <% if @assessments.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Profissional</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Criado em</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @assessments.each do |assessment| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <%= link_to assessment.title, assessment_path(assessment), class: "text-sm font-medium text-gray-900 hover:text-blue-600" %>
            </td>
            <td class="px-4 py-3"><%= render "shared/status_badge", status: assessment.status %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= assessment.owner.name %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= assessment.created_at.strftime("%d/%m/%Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-4 py-8 text-center text-sm text-gray-500">
      Nenhuma avaliação registrada
    </div>
  <% end %>
</div>
