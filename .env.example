# ============================================
# Laudos SaaS - Variáveis de Ambiente
# Copie para .env e preencha os valores
# ============================================

# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# Banco de dados
DATABASE_URL=postgres://postgres:postgres@localhost:5432/laudos_saas_development

# Host
APP_HOST=localhost:3000
APP_PROTOCOL=http

# E-mail (Devise)
SMTP_ADDRESS=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_DOMAIN=laudos-saas.com
MAILER_SENDER=noreply@laudos-saas.com

# Sidekiq / Background Jobs
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_SERVICE=local
# S3 (produção)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=laudos-saas-production

# LGPD / Segurança
ENABLE_AUDIT_LOG=true
SESSION_TIMEOUT_MINUTES=30
