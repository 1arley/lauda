<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Templates de Laudo</h1>
    <p class="mt-1 text-sm text-gray-500">Gerencie os templates para laudos</p>
  </div>
  <div class="mt-4 sm:mt-0">
    <%= link_to new_report_template_path, class: "inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" do %>
      <svg class="-ml-0.5 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Novo Template
    <% end %>
  </div>
</div>

<% if @report_templates.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @report_templates.each do |template| %>
      <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-4 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between mb-3">
          <h3 class="text-sm font-semibold text-gray-900"><%= template.name %></h3>
          <% if template.default? %>
            <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">Padrão</span>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mb-3 line-clamp-2"><%= template.description %></p>
        <div class="flex items-center justify-between">
          <span class="text-xs text-gray-400"><%= template.sections.size %> seções</span>
          <%= link_to "Editar", edit_report_template_path(template), class: "text-sm text-blue-600 hover:text-blue-800" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "Nenhum template", message: "Crie o primeiro template de laudo." %>
<% end %>
