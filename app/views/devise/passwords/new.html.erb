<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <div class="mx-auto h-12 w-12 rounded-xl bg-blue-600 flex items-center justify-center">
        <span class="text-white font-bold text-xl">L</span>
      </div>
      <h2 class="mt-6 text-3xl font-bold text-gray-900">Esqueceu a senha?</h2>
      <p class="mt-2 text-sm text-gray-600">Informe seu e-mail para redefinir</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-6" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="rounded-lg bg-red-50 p-4 border border-red-200">
          <ul class="text-sm text-red-700 space-y-1">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="rounded-lg bg-white p-6 shadow-sm border border-gray-200">
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        </div>
      </div>

      <div>
        <%= f.submit "Enviar instruções", class: "w-full flex justify-center rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      </div>

      <p class="text-center text-sm text-gray-600">
        <%= link_to "Voltar ao login", new_user_session_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
      </p>
    <% end %>
  </div>
</div>
