<div class="max-w-2xl">
  <div class="mb-8">
    <%= link_to report_templates_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Voltar
    <% end %>
    <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= @report_template.persisted? ? "Editar Template" : "Novo Template" %></h1>
  </div>

  <%= form_with(model: @report_template, class: "space-y-6") do |f| %>
    <% if @report_template.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 border border-red-200">
        <h3 class="text-sm font-medium text-red-800"><%= @report_template.errors.count %> erro(s)</h3>
        <ul class="mt-2 list-disc list-inside text-sm text-red-700">
          <% @report_template.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 space-y-4">
      <div>
        <%= f.label :name, "Nome *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :description, "Descrição", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :description, rows: 2, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :default, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
        <%= f.label :default, "Template padrão", class: "text-sm text-gray-700" %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Salvar", class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Cancelar", report_templates_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
    </div>
  <% end %>
</div>
