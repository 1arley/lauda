<div class="max-w-2xl">
  <div class="mb-8">
    <%= link_to snippets_path, class: "text-sm text-gray-500 hover:text-gray-700" do %>
      &larr; Voltar
    <% end %>
    <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= @snippet.persisted? ? "Editar Snippet" : "Novo Snippet" %></h1>
  </div>

  <%= form_with(model: @snippet, class: "space-y-6") do |f| %>
    <% if @snippet.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 border border-red-200">
        <h3 class="text-sm font-medium text-red-800">Revise os campos abaixo:</h3>
        <ul class="mt-2 list-disc list-inside text-sm text-red-700">
          <% @snippet.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 space-y-4">
      <div>
        <%= f.label :title, "Título *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :title, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :category, "Categoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :category, options_for_select(["conclusion", "recommendation", "procedure", "introduction", "other"], @snippet.category), { include_blank: "Selecione..." }, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :content, "Conteúdo *", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :content, rows: 6, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Salvar", class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Cancelar", snippets_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
    </div>
  <% end %>
</div>
