<div class="mb-8">
  <%= link_to assessment_path(@assessment), class: "text-sm text-gray-500 hover:text-gray-700" do %>
    &larr; Voltar para Avaliação
  <% end %>
  <div class="mt-2 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">3 de 3 · Resultados</h1>
      <p class="mt-1 text-sm text-gray-500"><%= @instrument_application.instrument_version.display_name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to score_assessment_instrument_application_path(@assessment, @instrument_application), class: "rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50" do %>
        Recalcular
      <% end %>
    </div>
  </div>
</div>

<% if @score_results.any? %>
  <% if @instrument_application.norm_changed? %>
    <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      A tabela normativa foi alterada desde este cálculo. Recalcule os resultados para usar a versão vigente.
    </div>
  <% end %>
  <div class="bg-white shadow-sm rounded-lg border border-gray-200 mb-6">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Tabela de Escores</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Subteste</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Bruto</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Padronizado</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Percentil</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Classificação</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @score_results.each do |result| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= result.subtest_name %></td>
            <td class="px-4 py-3 text-sm text-center text-gray-700"><%= result.raw_score %></td>
            <td class="px-4 py-3 text-sm text-center font-medium text-gray-900"><%= result.scaled_score %></td>
            <td class="px-4 py-3 text-sm text-center text-gray-700"><%= result.percentile %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= result.classification %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="bg-white shadow-sm rounded-lg border border-gray-200 mb-6">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Gráfico de Perfil</h2>
    </div>
    <div class="p-6">
      <div class="flex items-end gap-3 h-64">
        <% max_score = @score_results.map { |r| r.scaled_score.to_f }.max || 15 %>
        <% @score_results.each do |result| %>
          <div class="flex-1 flex flex-col items-center gap-1">
            <span class="text-xs font-medium text-gray-700"><%= result.scaled_score %></span>
            <div class="w-full rounded-t-lg bg-blue-500" style="height: <%= [(result.scaled_score.to_f / max_score * 100), 2].max %>%"></div>
            <span class="text-xs text-gray-500 text-center leading-tight mt-1"><%= result.subtest_name&.truncate(12) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex gap-3">
    <%= link_to "Enviar para laudo", new_assessment_report_path(@assessment), class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
    <%= link_to "Voltar para avaliação", assessment_path(@assessment), class: "rounded-lg bg-white px-4 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50" %>
  </div>
<% else %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-yellow-800">
    Nenhum resultado calculado ainda.
  </div>
<% end %>
