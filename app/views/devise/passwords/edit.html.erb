<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <div class="mx-auto h-12 w-12 rounded-xl bg-blue-600 flex items-center justify-center">
        <span class="text-white font-bold text-xl">L</span>
      </div>
      <h2 class="mt-6 text-3xl font-bold text-gray-900">Redefinir senha</h2>
      <p class="mt-2 text-sm text-gray-600">Escolha uma nova senha para sua conta</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 space-y-6" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="rounded-lg bg-red-50 p-4 border border-red-200">
          <ul class="text-sm text-red-700 space-y-1">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-4 rounded-lg bg-white p-6 shadow-sm border border-gray-200">
        <div>
          <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
        </div>
      </div>

      <%= f.submit "Alterar senha", class: "w-full flex justify-center rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  </div>
</div>
