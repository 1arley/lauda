# Imagem publicada pelo workflow do GitHub Actions
IMAGE_NAME=ghcr.io/1arley/lauda
IMAGE_TAG=latest

# domínio deste serviço. O registro DNS A aponta para a VPS e o Traefik da
# máquina emite o certificado TLS para ele. ACME_EMAIL não é usado aqui: o
# e-mail do Let's Encrypt é configurado no proxy reverso.
APP_HOST=lauda.1arley.dev

# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=COLOQUE_AQUI_UM_SEGREDO_ALEATORIO_DE_128_CARACTERES_HEXADECIMAIS

# Use somente letras e números na senha para manter DATABASE_URL válida
POSTGRES_DB=laudos_saas_production
POSTGRES_USER=laudos_saas
POSTGRES_PASSWORD=COLOQUE_AQUI_UMA_SENHA_ALEATORIA

# SMTP usado por cadastro, confirmação de e-mail e recuperação de senha.
# Com Resend: SMTP_ADDRESS=smtp.resend.com, SMTP_USER_NAME=resend e
# SMTP_PASSWORD é a API key (começa com re_). O remetente precisa ser um
# domínio verificado no Resend.
MAILER_SENDER=nao-responda@lauda.1arley.dev
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USER_NAME=resend
SMTP_PASSWORD=cole_aqui_a_api_key_do_resend
SMTP_DOMAIN=lauda.1arley.dev
