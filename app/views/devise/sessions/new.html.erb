<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <div class="mx-auto h-12 w-12 rounded-xl bg-blue-600 flex items-center justify-center">
        <span class="text-white font-bold text-xl">L</span>
      </div>
      <h2 class="mt-6 text-3xl font-bold text-gray-900">Lauda</h2>
      <p class="mt-2 text-sm text-gray-600">Entre com sua conta</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="space-y-4 rounded-lg bg-white p-6 shadow-sm border border-gray-200">
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500", placeholder: "seu@email.com" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500", placeholder: "Sua senha" %>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
            <%= f.label :remember_me, "Lembrar de mim", class: "text-sm text-gray-700" %>
          </div>
          <%= link_to "Esqueci a senha", new_password_path(resource_name), class: "text-sm text-blue-600 hover:text-blue-800" %>
        </div>
      </div>

      <div>
        <%= f.submit "Entrar", class: "w-full flex justify-center rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      </div>
    <% end %>
    <p class="text-center text-sm text-gray-600">
      Primeira vez aqui? <%= link_to "Criar conta da clínica", new_user_registration_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </p>
  </div>
</div>
