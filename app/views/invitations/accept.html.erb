<div class="max-w-2xl">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Aceitar convite</h1>
    <p class="mt-1 text-sm text-gray-500">
      <%= @invitation.tenant.name %> convidou você como <%= @invitation.role.humanize.downcase %>.
    </p>
  </div>

  <%= form_with(url: accept_invitation_path(token: params[:token]), method: :patch, class: "space-y-6") do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 border border-red-200">
        <ul class="mt-2 list-disc list-inside text-sm text-red-700">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm rounded-lg border border-gray-200 p-6 space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nome completo *</label>
        <%= f.text_field "registration[name]", value: @user.name, required: true, autofocus: true, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:border-blue-500" %>
      </div>

      <div class="rounded-lg bg-gray-50 border border-gray-200 p-3 text-sm text-gray-600">
        E-mail: <span class="font-medium text-gray-900"><%= @invitation.email %></span>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Senha *</label>
        <%= f.password_field "registration[password]", required: true, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:border-blue-500" %>
        <p class="mt-2 text-xs text-gray-500">Mínimo de 6 caracteres.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Confirme a senha *</label>
        <%= f.password_field "registration[password_confirmation]", required: true, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:border-blue-500" %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Criar minha conta", class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Cancelar", new_user_session_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
    </div>
  <% end %>
</div>
