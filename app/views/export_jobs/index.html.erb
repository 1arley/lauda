<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Exportações</h1>
  <p class="mt-1 text-sm text-gray-500">Histórico de exportações de PDF</p>
</div>

<% if @export_jobs.any? %>
  <div class="bg-white shadow-sm rounded-lg border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Laudo</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Solicitado por</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Data</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Ação</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @export_jobs.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm text-gray-900"><%= job.report.report_template.name %></td>
            <td class="px-4 py-3"><%= render "shared/status_badge", status: job.status %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= job.user.name %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= job.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td class="px-4 py-3 text-right">
              <% if job.completed? %>
                <%= link_to "Download", export_job_path(job), class: "text-sm text-blue-600 hover:text-blue-800" %>
              <% elsif job.failed? %>
                <span class="text-sm text-red-600"><%= job.error_message %></span>
              <% else %>
                <span class="text-sm text-gray-400">Processando...</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "Nenhuma exportação", message: "Exportações de PDF aparecerão aqui." %>
<% end %>
